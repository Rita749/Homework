def pdf_to_high_quality_images(pdf_path, dpi=300):
    """
    Конвертирует PDF в высококачественные изображения
    """
    images = []
    doc = fitz.open(pdf_path)
    
    for page_num in range(len(doc)):
        page = doc.load_page(page_num)
        # Увеличиваем DPI для лучшего качества
        mat = fitz.Matrix(dpi/72, dpi/72)
        pix = page.get_pixmap(matrix=mat, alpha=False)
        img_data = pix.tobytes("ppm")
        img = Image.open(io.BytesIO(img_data))
        images.append(img)
    
    doc.close()
    return images

def enhance_grayscale(image):
    """
    Улучшает изображение в оттенках серого с сохранением качества
    """
    # Конвертируем в оттенки серого (сохраняем все детали)
    gray_image = image.convert('L')
    
    # Улучшаем контрастность
    enhancer = ImageEnhance.Contrast(gray_image)
    gray_image = enhancer.enhance(1.2)
    
    # Улучшаем резкость
    enhancer = ImageEnhance.Sharpness(gray_image)
    gray_image = enhancer.enhance(1.1)
    
    return gray_image

def resize_to_a4_high_quality(image):
    """
    Изменяет размер изображения под формат A4 с максимальным качеством
    """
    a4_width, a4_height = A4
    
    # Рассчитываем размер с учетом полей (5% с каждой стороны)
    target_width = int(a4_width * 0.95)
    target_height = int(a4_height * 0.95)
    
    # Сохраняем пропорции
    img_ratio = image.width / image.height
    target_ratio = target_width / target_height
    
    if img_ratio > target_ratio:
        # Изображение шире
        new_width = target_width
        new_height = int(target_width / img_ratio)
    else:
        # Изображение выше
        new_height = target_height
        new_width = int(target_height * img_ratio)
    
    # Используем высококачественное масштабирование
    resized_image = image.resize((new_width, new_height), Image.Resampling.LANCZOS)
    
    # Создаем белый фон A4
    background = Image.new('L', (int(a4_width), int(a4_height)), 255)
    
    # Центрируем изображение на фоне
    x_offset = (background.width - resized_image.width) // 2
    y_offset = (background.height - resized_image.height) // 2
    background.paste(resized_image, (x_offset, y_offset))
    
    return background

def images_to_high_quality_pdf(images, output_path, quality=95):
    """
    Конвертирует список изображений в высококачественный PDF
    """
    c = canvas.Canvas(output_path, pagesize=A4)
    
    for i, img in enumerate(images):
        print(f"Добавление страницы {i+1} в PDF...")
        
        # Сохраняем временное изображение в высоком качестве
        with tempfile.NamedTemporaryFile(suffix='.png', delete=False) as temp_file:
            temp_path = temp_file.name
            # Сохраняем с максимальным качеством
            img.save(temp_path, 'PNG', optimize=True, quality=quality)
        
        try:
            img_reader = ImageReader(temp_path)
            img_width, img_height = img_reader.getSize()
            
            # Масштабируем изображение под размер A4
            a4_width, a4_height = A4
            scale = min(a4_width / img_width, a4_height / img_height)
            scaled_width = img_width * scale
            scaled_height = img_height * scale
            
            # Центрируем изображение
            x = (a4_width - scaled_width) / 2
            y = (a4_height - scaled_height) / 2
            
            c.drawImage(img_reader, x, y, scaled_width, scaled_height, preserveAspectRatio=True)
            c.showPage()
        
        finally:
            # Удаляем временный файл
            if os.path.exists(temp_path):
                os.unlink(temp_path)
    
    c.save()

def optimize_for_text_and_images(image):
    """
    Оптимизирует изображение для лучшего отображения текста и графики
    """
    # Легкое повышение резкости для текста
    sharpened = image.filter(ImageFilter.UnsharpMask(radius=1, percent=150, threshold=3))
    
    # Автоматическая коррекция контраста
    optimized = ImageOps.autocontrast(sharpened, cutoff=2)
    
    return optimized

def convert_pdf_to_grayscale_a4(input_pdf, output_pdf, dpi=300, enhance_quality=True):
    """
    Основная функция конвертации PDF в оттенки серого формата A4
    """
    print(f"🔄 Конвертация: {os.path.basename(input_pdf)} -> {os.path.basename(output_pdf)}")
    print(f"📊 Качество: {dpi} DPI")
    
    try:
        # Конвертируем PDF в высококачественные изображения
        print("📄 Извлечение страниц из PDF...")
        images = pdf_to_high_quality_images(input_pdf, dpi=dpi)
        
        processed_images = []
        
        # Обрабатываем каждое изображение
        for i, img in enumerate(images):
            print(f"⚙️ Обработка страницы {i+1}/{len(images)}...")
            
            # Конвертируем в оттенки серого с улучшением качества
            gray_img = enhance_grayscale(img)
            
            # Дополнительная оптимизация для текста
            if enhance_quality:
                gray_img = optimize_for_text_and_images(gray_img)
            
            # Изменяем размер под A4 с сохранением качества
            a4_img = resize_to_a4_high_quality(gray_img)
            
            processed_images.append(a4_img)
        
        # Создаем высококачественный PDF
        print("📑 Создание PDF в оттенках серого...")
        images_to_high_quality_pdf(processed_images, output_pdf, quality=95)
        
        # Проверяем размер файла
        original_size = os.path.getsize(input_pdf) / (1024 * 1024)  # в MB
        final_size = os.path.getsize(output_pdf) / (1024 * 1024)    # в MB
        print(f"✅ Конвертация завершена: {output_pdf}")
        print(f"📦 Размер исходного файла: {original_size:.2f} MB")
        print(f"📦 Размер конечного файла: {final_size:.2f} MB")
        print(f"📈 Изменение размера: {final_size - original_size:+.2f} MB")
        
        return True, original_size, final_size
        
    except Exception as e:
        print(f"❌ Ошибка при конвертации: {e}")
        import traceback
        traceback.print_exc()
        return False, 0, 0

def create_pdf_preview_images(pdf_path, output_folder, max_pages=3):
    """
    Создает превью страниц PDF для вставки в документацию
    """
    preview_images = []
    try:
        doc = fitz.open(pdf_path)
        
        # Ограничиваем количество страниц для превью
        pages_to_process = min(len(doc), max_pages)
        
        for page_num in range(pages_to_process):
            page = doc.load_page(page_num)
            # Используем меньшее разрешение для превью
            mat = fitz.Matrix(150/72, 150/72)  # 150 DPI для превью
            pix = page.get_pixmap(matrix=mat, alpha=False)
            
            # Сохраняем превью как PNG
            preview_path = os.path.join(output_folder, f"preview_page_{page_num+1}.png")
            pix.save(preview_path)
            preview_images.append(preview_path)
            
        doc.close()
        
    except Exception as e:
        print(f"⚠️ Ошибка создания превью: {e}")
    
    return preview_images

